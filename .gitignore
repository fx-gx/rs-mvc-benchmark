__pycache__/
*.pyc
.venv/
*.tmp

# FedRSMVC 用相对路径写的图（适配器不 chdir，会落到这里）
results/Trento_*.png
results/Augsburg_*.png
results/Salinas_*.png
results/*_log.csv
result/*.pdf

# FedRSMVC 的客户端检查点（适配器运行时生成，勿入库）
save/

# Claude Code 本地设置（含本机绝对路径与权限记录，不应公开）
.claude/settings.json
.claude/settings.local.json
.claude/scheduled_tasks.lock

# 逐次运行的散装日志（results/archive/ 里的调参记录是刻意保留的实验档案，不受影响）
results/*.log
